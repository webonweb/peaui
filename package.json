{
  "name": "@peaui/ui",
  "private": true,
  "packageManager": "npm@11.6.0",
  "browserslist": [
    ">= 0.5%",
    "last 2 Chrome versions",
    "last 2 Edge versions",
    "last 2 Firefox versions",
    "last 2 Safari versions",
    "not dead"
  ],
  "workspaces": [
    "packages/*",
    "packages/**/*"
  ],
  "scripts": {
    "build": "npm-run-all -s library:build docs:build",
    "storybook:wc": "npm -w packages/storybook/wc run storybook",
    "storybook:react": "npm -w packages/storybook/react run storybook",
    "storybook:vue": "npm -w packages/storybook/vue run storybook",
    "storybook:shell": "npm -w packages/storybook/shell run storybook",
    "storybook": "npm-run-all -p storybook:vue storybook:react storybook:wc storybook:shell",
    "storybook:build:wc": "npm -w packages/storybook/wc run build-storybook",
    "storybook:build:react": "npm -w packages/storybook/react run build-storybook",
    "storybook:build:vue": "npm -w packages/storybook/vue run build-storybook",
    "storybook:build:shell": "npm -w packages/storybook/shell run build-storybook",
    "storybook:build": "npm-run-all -p storybook:build:vue storybook:build:react storybook:build:wc storybook:build:shell",
    "storybook:check:catalog": "node scripts/check-storybook-catalog.mjs",
    "storybook:check:catalog:build": "npm-run-all -p storybook:build:vue storybook:build:react storybook:build:wc && npm run storybook:check:catalog",
    "docs": "npm -w packages/docs run dev",
    "docs:build": "npm -w packages/docs run build",
    "docs:preview": "npm -w packages/docs run preview",
    "docs:typecheck": "npm -w packages/docs run typecheck",
    "docs:test": "npm -w packages/docs run test",
    "docs:test:browser": "npm -w packages/docs run test:browser",
    "docs:lint": "npm -w packages/docs run lint",
    "docs:format": "npm -w packages/docs run format",
    "docs:vue": "npm run storybook:vue",
    "react:check": "node packages/library/scripts/generate-react-components.mjs --check",
    "react:generate": "npm -w packages/library run react:generate",
    "library:build": "npm -w packages/library run build",
    "library:build:watch": "npm -w packages/library run watch",
    "playground": "npm -w packages/playground/${npm_config_framework} run dev",
    "playground:watch": "npm-run-all -p library:build:watch playground",
    "test": "npm-run-all -s test:vue test:react test:wc",
    "test:vue": "npm -w packages/library run test:vue",
    "test:vue:browser": "npm -w packages/storybook/vue run test:browser",
    "test:vue:browser:install": "npm -w packages/storybook/vue run test:browser:install",
    "test:react:browser": "npm -w packages/storybook/react run test:browser",
    "test:react:browser:install": "npm -w packages/storybook/react run test:browser:install",
    "test:react": "npm -w packages/library run test:react",
    "test:wc": "npm -w packages/library run test:wc",
    "test:wc:browser": "npm -w packages/storybook/wc run test:browser",
    "test:wc:browser:install": "npm -w packages/storybook/wc run test:browser:install",
    "prepare": "husky",
    "library:lint": "npm -w packages/library run lint",
    "playground:lint:react": "npm -w packages/playground/react run lint",
    "playground:lint:vue": "npm -w packages/playground/vue run lint",
    "playground:lint": "npm-run-all -s playground:lint:react playground:lint:vue",
    "playground:build:react": "npm -w packages/playground/react run build",
    "playground:build:vue": "npm -w packages/playground/vue run build",
    "playground:build:wc": "npm -w packages/playground/wc run build",
    "playground:build": "npm-run-all -s playground:build:vue playground:build:react playground:build:wc",
    "library:format": "npm -w packages/library run format",
    "library:format:write": "npm -w packages/library run format:fix",
    "library:typecheck": "npm -w packages/library run typecheck",
    "check": "npm-run-all -s react:check library:lint playground:lint docs:lint library:format docs:format library:typecheck library:typecheck:tests docs:typecheck docs:test test library:build playground:build docs:build",
    "changeset": "changeset",
    "release:version": "changeset version",
    "release:version:patch": "npm version patch --workspace packages/library --no-git-tag-version",
    "release:version:minor": "npm version minor --workspace packages/library --no-git-tag-version",
    "release:version:major": "npm version major --workspace packages/library --no-git-tag-version",
    "release:pack": "npm pack --workspace packages/library",
    "release:artifact": "node scripts/release-artifact.mjs",
    "release:pack:dry-run": "npm pack --workspace packages/library --dry-run",
    "release:package:check": "node scripts/validate-package.mjs",
    "release:types:check": "tsc scripts/package-smoke.ts scripts/package-api-smoke.tsx --noEmit --target ES2022 --module ESNext --moduleResolution Bundler --jsx react-jsx --skipLibCheck",
    "release:check": "npm-run-all -s check release:package:check release:types:check release:pack:dry-run",
    "release:npm:dry-run": "npm publish --workspace packages/library --access public --dry-run",
    "release:npm": "npm publish --workspace packages/library --access public",
    "release:changesets": "npm run release:check && changeset publish",
    "library:typecheck:tests": "npm -w packages/library run typecheck:tests",
    "test:production": "node scripts/check-production-contracts.cjs --verify && node scripts/check-production-contracts.cjs --verify --extra",
    "test:hydration": "node scripts/check-hydration.mjs",
    "test:browser:contracts": "node scripts/browser-forms.cjs && node scripts/browser-interactions.cjs && node scripts/browser-display.cjs"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@commitlint/cli": "^20.4.0",
    "@commitlint/config-conventional": "^20.4.0",
    "husky": "^9.1.7",
    "nanoid": "^3.3.18",
    "npm-run-all": "^4.1.5",
    "uuid": "^11.1.1"
  },
  "overrides": {
    "nanoid": "^3.3.18",
    "uuid": "^11.1.1",
    "@vue/test-utils": "2.4.11"
  }
}
