{
  "name": "@peaui/ui",
  "type": "module",
  "version": "3.0.1",
  "description": "UI components with shared design tokens and accessible interactions for Vue, React, and Web Components.",
  "license": "MIT",
  "keywords": [
    "accessibility",
    "component-library",
    "design-system",
    "react",
    "typescript",
    "vue",
    "wcag",
    "web-components"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/webonweb/peaui.git",
    "directory": "packages/library"
  },
  "bugs": {
    "url": "https://github.com/webonweb/peaui/issues"
  },
  "homepage": "https://github.com/webonweb/peaui",
  "sideEffects": [
    "**/*.css",
    "**/*.scss",
    "**/*.sass",
    "**/*.less",
    "**/styles.js",
    "**/styles.ts",
    "./dist/components/wc/**/*.js",
    "./dist/components/wc/**/*.cjs"
  ],
  "customElements": "./custom-elements.json",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "node": {
        "import": "./dist/node/index.mjs",
        "require": "./dist/index.umd.cjs"
      },
      "import": "./dist/index.js",
      "require": "./dist/index.umd.cjs",
      "default": "./dist/index.js"
    },
    "./styles": {
      "types": "./dist/styles.d.ts",
      "node": {
        "import": "./dist/node/styles.mjs",
        "require": "./dist/styles.umd.cjs"
      },
      "import": "./dist/styles.js",
      "require": "./dist/styles.umd.cjs",
      "default": "./dist/styles.js"
    },
    "./styles.css": "./dist/styles.css",
    "./style.css": "./dist/styles.css",
    "./web-components": {
      "types": "./dist/web-components.d.ts",
      "node": {
        "import": "./dist/node/web-components.mjs",
        "require": "./dist/web-components.umd.cjs"
      },
      "import": "./dist/web-components.js",
      "require": "./dist/web-components.umd.cjs",
      "default": "./dist/web-components.js"
    },
    "./vue/*": {
      "types": "./dist/vue/*.d.ts",
      "node": {
        "import": "./dist/node/components/vue/*.mjs",
        "require": "./dist/components/vue/*.umd.cjs"
      },
      "import": "./dist/components/vue/*.js",
      "require": "./dist/components/vue/*.umd.cjs",
      "default": "./dist/components/vue/*.js"
    },
    "./react/*": {
      "types": "./dist/react/*.d.ts",
      "node": {
        "import": "./dist/node/components/react/*.mjs",
        "require": "./dist/components/react/*.umd.cjs"
      },
      "import": "./dist/components/react/*.js",
      "require": "./dist/components/react/*.umd.cjs",
      "default": "./dist/components/react/*.js"
    },
    "./wc/*": {
      "types": "./dist/wc/*.d.ts",
      "import": "./dist/components/wc/*.js",
      "require": "./dist/components/wc/*.umd.cjs",
      "default": "./dist/components/wc/*.js"
    },
    "./dist/components/wc/*.js": {
      "types": "./dist/wc/*.d.ts",
      "import": "./dist/components/wc/*.js",
      "require": "./dist/components/wc/*.umd.cjs",
      "default": "./dist/components/wc/*.js"
    },
    "./basic/*": {
      "types": "./dist/vue/basic/*.d.ts",
      "node": {
        "import": "./dist/node/components/vue/basic/*.mjs",
        "require": "./dist/components/vue/basic/*.umd.cjs"
      },
      "import": "./dist/components/vue/basic/*.js",
      "require": "./dist/components/vue/basic/*.umd.cjs",
      "default": "./dist/components/vue/basic/*.js"
    },
    "./data-display/*": {
      "types": "./dist/vue/data-display/*.d.ts",
      "node": {
        "import": "./dist/node/components/vue/data-display/*.mjs",
        "require": "./dist/components/vue/data-display/*.umd.cjs"
      },
      "import": "./dist/components/vue/data-display/*.js",
      "require": "./dist/components/vue/data-display/*.umd.cjs",
      "default": "./dist/components/vue/data-display/*.js"
    },
    "./data-entry/*": {
      "types": "./dist/vue/data-entry/*.d.ts",
      "node": {
        "import": "./dist/node/components/vue/data-entry/*.mjs",
        "require": "./dist/components/vue/data-entry/*.umd.cjs"
      },
      "import": "./dist/components/vue/data-entry/*.js",
      "require": "./dist/components/vue/data-entry/*.umd.cjs",
      "default": "./dist/components/vue/data-entry/*.js"
    },
    "./layout/*": {
      "types": "./dist/vue/layout/*.d.ts",
      "node": {
        "import": "./dist/node/components/vue/layout/*.mjs",
        "require": "./dist/components/vue/layout/*.umd.cjs"
      },
      "import": "./dist/components/vue/layout/*.js",
      "require": "./dist/components/vue/layout/*.umd.cjs",
      "default": "./dist/components/vue/layout/*.js"
    },
    "./form/*": {
      "types": "./dist/vue/form/*.d.ts",
      "node": {
        "import": "./dist/node/components/vue/form/*.mjs",
        "require": "./dist/components/vue/form/*.umd.cjs"
      },
      "import": "./dist/components/vue/form/*.js",
      "require": "./dist/components/vue/form/*.umd.cjs",
      "default": "./dist/components/vue/form/*.js"
    },
    "./overlayer/*": {
      "types": "./dist/vue/overlayer/*.d.ts",
      "node": {
        "import": "./dist/node/components/vue/overlayer/*.mjs",
        "require": "./dist/components/vue/overlayer/*.umd.cjs"
      },
      "import": "./dist/components/vue/overlayer/*.js",
      "require": "./dist/components/vue/overlayer/*.umd.cjs",
      "default": "./dist/components/vue/overlayer/*.js"
    },
    "./navigation/*": {
      "types": "./dist/vue/navigation/*.d.ts",
      "node": {
        "import": "./dist/node/components/vue/navigation/*.mjs",
        "require": "./dist/components/vue/navigation/*.umd.cjs"
      },
      "import": "./dist/components/vue/navigation/*.js",
      "require": "./dist/components/vue/navigation/*.umd.cjs",
      "default": "./dist/components/vue/navigation/*.js"
    },
    "./feedback/*": {
      "types": "./dist/vue/feedback/*.d.ts",
      "node": {
        "import": "./dist/node/components/vue/feedback/*.mjs",
        "require": "./dist/components/vue/feedback/*.umd.cjs"
      },
      "import": "./dist/components/vue/feedback/*.js",
      "require": "./dist/components/vue/feedback/*.umd.cjs",
      "default": "./dist/components/vue/feedback/*.js"
    },
    "./package.json": "./package.json",
    "./vue": {
      "types": "./dist/index.d.ts",
      "node": {
        "import": "./dist/node/index.mjs",
        "require": "./dist/index.umd.cjs"
      },
      "import": "./dist/index.js",
      "require": "./dist/index.umd.cjs",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "node": {
        "import": "./dist/node/components/react.mjs",
        "require": "./dist/components/react.umd.cjs"
      },
      "import": "./dist/components/react.js",
      "require": "./dist/components/react.umd.cjs",
      "default": "./dist/components/react.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "node": {
        "import": "./dist/node/components/vite.mjs",
        "require": "./dist/components/vite.umd.cjs"
      },
      "import": "./dist/components/vite.js",
      "require": "./dist/components/vite.umd.cjs",
      "default": "./dist/components/vite.js"
    }
  },
  "main": "./dist/index.umd.cjs",
  "module": "./dist/index.js",
  "style": "./dist/styles.css",
  "types": "./dist/index.d.ts",
  "typings": "./dist/index.d.ts",
  "files": [
    "dist",
    "custom-elements.json",
    "peaui-logo.png",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_LICENSES.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "npm run package:entries:check && npm run icons:check && npm run custom-elements:check && npm run build-only && npm run build:verify",
    "build-only": "vite build",
    "build:verify": "node ../../scripts/validate-package.mjs && node ../../scripts/package-consumer.test.mjs",
    "react:generate": "node ./scripts/generate-react-components.mjs && prettier \"./src/react/generated-*.ts\" \"./src/components/**/index.tsx\" \"./src/components/**/*.react.stories.tsx\" --write",
    "react:generate:metadata": "node ./scripts/generate-react-components.mjs --metadata-only && prettier \"./src/react/generated-*.ts\" --write",
    "icons:sync": "node ./scripts/sync-icon-catalog.mjs",
    "icons:check": "node ./scripts/sync-icon-catalog.mjs --check",
    "custom-elements:generate": "node ./scripts/generate-custom-elements-manifest.mjs",
    "custom-elements:check": "node ./scripts/generate-custom-elements-manifest.mjs --check",
    "watch": "vite build --watch",
    "typecheck": "vue-tsc --noEmit -p tsconfig.build.json",
    "type-gen": "vue-tsc --declaration --emitDeclarationOnly -p tsconfig.build.json",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier \"src/**/*.{ts,tsx,vue,scss}\" \"scripts/**/*.{mjs,ts}\" \"*.{js,ts,json}\" --check",
    "format:fix": "prettier \"src/**/*.{ts,tsx,vue,scss}\" \"scripts/**/*.{mjs,ts}\" \"*.{js,ts,json}\" --write",
    "test": "vitest run --config ./vitest.config.ts",
    "test:vue": "node ./scripts/test-framework.mjs vue",
    "test:react": "node ./scripts/test-framework.mjs react",
    "test:wc": "node ./scripts/test-framework.mjs wc",
    "test:all": "npm-run-all -s test:vue test:react test:wc",
    "test:coverage": "vitest run --config ./vitest.config.ts --coverage",
    "test:coverage:vue": "node ./scripts/test-framework.mjs vue --coverage",
    "test:coverage:react": "node ./scripts/test-framework.mjs react --coverage",
    "test:coverage:wc": "node ./scripts/test-framework.mjs wc --coverage",
    "test:coverage:all": "npm-run-all -s test:coverage:vue test:coverage:react test:coverage:wc",
    "check": "npm-run-all -s icons:check lint format typecheck typecheck:tests test:all",
    "prepack": "npm run build && npm --prefix ../.. run release:types:check",
    "prepublishOnly": "npm --prefix ../.. run security:check && npm run check",
    "package:entries:generate": "node ./scripts/generate-package-entries.mjs",
    "package:entries:check": "node ./scripts/generate-package-entries.mjs --check",
    "test:coverage:wc:behavior": "node ./scripts/test-framework.mjs wc --coverage --behavior",
    "typecheck:tests": "vue-tsc --noEmit -p tsconfig.tests.json"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "vue": "^3.5.0",
    "vite": "^6.4.0 || ^7.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/vue": "^8.1.0",
    "@types/node": "^24.8.1",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.10",
    "@vue/tsconfig": "^0.8.1",
    "ajv": "^8.17.1",
    "autoprefixer": "^10.4.21",
    "eslint-config-prettier": "^10.1.1",
    "eslint-define-config": "^2.1.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-vue": "^10.0.0",
    "eslint-plugin-vuejs-accessibility": "^2.6.0",
    "glob": "^11.0.3",
    "globals": "^16.5.0",
    "jsdom": "^27.4.0",
    "postcss": "^8.5.3",
    "prettier": "^3.5.3",
    "prettier-plugin-css-order": "^2.1.2",
    "prettier-plugin-organize-attributes": "^1.0.0",
    "sass": "^1.93.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.49.0",
    "vite": "^7.1.10",
    "vite-plugin-dts": "^4.5.3",
    "vite-plugin-lib-inject-css": "^2.2.2",
    "vite-svg-loader": "^5.1.1",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.1.1",
    "magic-string": "^0.30.21",
    "entities": "^6.0.1"
  },
  "imports": {
    "#peaui-html-decoder": {
      "browser": {
        "import": "./dist/components/internal/html-decoder.browser.js",
        "require": "./dist/components/internal/html-decoder.browser.umd.cjs"
      },
      "default": {
        "import": "./dist/node/components/internal/html-decoder.mjs",
        "require": "./dist/components/internal/html-decoder.umd.cjs"
      }
    }
  }
}
