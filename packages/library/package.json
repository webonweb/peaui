{
  "name": "@peaui/ui",
  "type": "module",
  "version": "1.27.0",
  "description": "Dostępna biblioteka komponentów PEAUI dla Vue, React i Web Components.",
  "license": "MIT",
  "keywords": [
    "accessibility",
    "component-library",
    "design-system",
    "react",
    "typescript",
    "vue",
    "wcag",
    "web-components"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://gitlab.gunb.gov.pl/duc-peaui/tools/ui-components.git",
    "directory": "packages/library"
  },
  "bugs": {
    "url": "https://gitlab.gunb.gov.pl/duc-peaui/tools/ui-components/-/issues"
  },
  "homepage": "https://gitlab.gunb.gov.pl/duc-peaui/tools/ui-components",
  "sideEffects": [
    "**/*.css",
    "**/*.scss",
    "**/*.sass",
    "**/*.less",
    "**/styles.js",
    "**/styles.ts"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.umd.cjs",
      "default": "./dist/index.js"
    },
    "./styles": {
      "types": "./dist/styles.d.ts",
      "import": "./dist/styles.js",
      "require": "./dist/styles.umd.cjs",
      "default": "./dist/styles.js"
    },
    "./styles.css": "./dist/styles.css",
    "./style.css": "./dist/styles.css",
    "./vue/*": {
      "types": "./dist/vue/*.d.ts",
      "import": "./dist/components/vue/*.js",
      "require": "./dist/components/vue/*.umd.cjs",
      "default": "./dist/components/vue/*.js"
    },
    "./react/*": {
      "types": "./dist/react/*.d.ts",
      "import": "./dist/components/react/*.js",
      "require": "./dist/components/react/*.umd.cjs",
      "default": "./dist/components/react/*.js"
    },
    "./react/basic/PhotoEditor": {
      "types": "./dist/react/basic/PhotoEditior.d.ts",
      "import": "./dist/components/react/basic/PhotoEditior.js",
      "require": "./dist/components/react/basic/PhotoEditior.umd.cjs",
      "default": "./dist/components/react/basic/PhotoEditior.js"
    },
    "./wc/*": {
      "types": "./dist/wc/*.d.ts",
      "import": "./dist/components/wc/*.js",
      "require": "./dist/components/wc/*.umd.cjs",
      "default": "./dist/components/wc/*.js"
    },
    "./basic/*": {
      "types": "./dist/vue/basic/*.d.ts",
      "import": "./dist/components/vue/basic/*.js",
      "require": "./dist/components/vue/basic/*.umd.cjs",
      "default": "./dist/components/vue/basic/*.js"
    },
    "./data-display/*": {
      "types": "./dist/vue/data-display/*.d.ts",
      "import": "./dist/components/vue/data-display/*.js",
      "require": "./dist/components/vue/data-display/*.umd.cjs",
      "default": "./dist/components/vue/data-display/*.js"
    },
    "./data-entry/*": {
      "types": "./dist/vue/data-entry/*.d.ts",
      "import": "./dist/components/vue/data-entry/*.js",
      "require": "./dist/components/vue/data-entry/*.umd.cjs",
      "default": "./dist/components/vue/data-entry/*.js"
    },
    "./layout/*": {
      "types": "./dist/vue/layout/*.d.ts",
      "import": "./dist/components/vue/layout/*.js",
      "require": "./dist/components/vue/layout/*.umd.cjs",
      "default": "./dist/components/vue/layout/*.js"
    },
    "./form/*": {
      "types": "./dist/vue/form/*.d.ts",
      "import": "./dist/components/vue/form/*.js",
      "require": "./dist/components/vue/form/*.umd.cjs",
      "default": "./dist/components/vue/form/*.js"
    },
    "./overlayer/*": {
      "types": "./dist/vue/overlayer/*.d.ts",
      "import": "./dist/components/vue/overlayer/*.js",
      "require": "./dist/components/vue/overlayer/*.umd.cjs",
      "default": "./dist/components/vue/overlayer/*.js"
    },
    "./navigation/*": {
      "types": "./dist/vue/navigation/*.d.ts",
      "import": "./dist/components/vue/navigation/*.js",
      "require": "./dist/components/vue/navigation/*.umd.cjs",
      "default": "./dist/components/vue/navigation/*.js"
    },
    "./feedback/*": {
      "types": "./dist/vue/feedback/*.d.ts",
      "import": "./dist/components/vue/feedback/*.js",
      "require": "./dist/components/vue/feedback/*.umd.cjs",
      "default": "./dist/components/vue/feedback/*.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.umd.cjs",
  "module": "./dist/index.js",
  "style": "./dist/styles.css",
  "types": "./dist/index.d.ts",
  "typings": "./dist/index.d.ts",
  "files": [
    "dist",
    "peaui-logo.png",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "npm run build-only && npm run build:verify",
    "build-only": "vite build",
    "build:verify": "node ../../scripts/validate-package.mjs",
    "react:generate": "node ./scripts/generate-react-components.mjs && prettier \"./src/react/generated-*.ts\" \"./src/components/**/index.tsx\" \"./src/components/**/*.react.stories.tsx\" --write",
    "watch": "vite build --watch",
    "typecheck": "vue-tsc --noEmit -p tsconfig.build.json",
    "type-gen": "vue-tsc --declaration --emitDeclarationOnly -p tsconfig.build.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier './src/**/*.{ts,tsx,vue}' --check",
    "format:fix": "prettier './src/**/*.{ts,tsx,vue}' --write",
    "test": "vitest run --config ./vitest.config.ts",
    "test:vue": "npm run test --framework=vue",
    "test:react": "npm run test --framework=react",
    "test:wc": "npm run test --framework=wc",
    "test:all": "npm-run-all -s test:vue test:react test:wc",
    "check": "npm-run-all -s lint format typecheck test:all",
    "build:css": "tailwindcss -i src/assets/styles.css -o dist/components/assets/styles.css --minify",
    "prepack": "npm run build && npm --prefix ../.. run release:types:check",
    "prepublishOnly": "npm run check"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "vue": "^3.4.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.18",
    "@tailwindcss/vite": "^4.1.18",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/vue": "^8.1.0",
    "@types/node": "^24.8.1",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vitest/ui": "^4.1.10",
    "@vue/tsconfig": "^0.8.1",
    "ajv": "^8.17.1",
    "autoprefixer": "^10.4.21",
    "eslint-config-prettier": "^10.1.1",
    "eslint-define-config": "^2.1.0",
    "eslint-plugin-vue": "^10.0.0",
    "glob": "^11.0.3",
    "jsdom": "^27.4.0",
    "postcss": "^8.5.3",
    "prettier": "^3.5.3",
    "prettier-plugin-css-order": "^2.1.2",
    "prettier-plugin-organize-attributes": "^1.0.0",
    "sass": "^1.93.2",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.49.0",
    "vite": "^7.1.10",
    "vite-plugin-dts": "^4.5.3",
    "vite-plugin-glob": "^0.3.2",
    "vite-plugin-lib-inject-css": "^2.2.2",
    "vite-svg-loader": "^5.1.1",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.1.1"
  },
  "dependencies": {
    "@vee-validate/yup": "^4.15.1",
    "vee-validate": "^4.15.1",
    "vue-advanced-cropper": "^2.8.9",
    "yup": "^1.7.1"
  }
}
